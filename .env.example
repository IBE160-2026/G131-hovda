# Kopier til .env.local (dev-server), .env.dev.local og .env.prod.local (scripts) og fyll inn verdier.
# Ekte verdier skal aldri committes.
#
# .env.dev.local og .env.prod.local brukes av `npm run import -- --target dev|prod`. De trenger
# NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (dashbordet, Settings → API) og OWNER_EMAIL
# for det miljøet. Service role-nøkkelen omgår RLS, så hold den unna nettleseren og git.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Eieren av appen (brukes av import og eksport)
OWNER_EMAIL=

# Amazon Bedrock (KI)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Testkonto i dev for RLS-testen (`npm run test:dev`). Bare i .env.local, aldri i prod.
RLS_TEST_EMAIL=
RLS_TEST_PASSWORD=
